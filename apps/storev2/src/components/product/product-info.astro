---
import { LOW_STOCK_THRESHOLD, productSale, SALE_CAMPAIGN } from "@vit/shared/domain/product";
import ProductQuantitySelector from "@/components/product/product-add-to-cart";
import CampaignClock from "@/components/sale/campaign-clock.astro";
import { formatCurrency } from "@/lib/utils";
import { CashOutIcon as IconRefund, ShieldCheckIcon as IconShield, DeliveryIcon as IconTruck } from "@solar-icons/solid/linear";
import { CheckCircleIcon as IconCheck } from "@solar-icons/solid/bold";

interface Props {
	primaryImage: string;
	product: {
		amount?: string | null;
		brand: { name: string };
		category: { name: string };
		compareAtPrice?: number | null;
		id: number;
		name: string;
		potency?: string | null;
		price: number;
		slug: string;
		status: string;
		stock: number;
	};
}

const { primaryImage, product } = Astro.props;
const isInStock = product.status === "active" && product.stock > 0;
const sale = productSale(product);
const campaignIds: ReadonlyArray<number> = SALE_CAMPAIGN.productIds;
const inCampaign = sale !== null && campaignIds.includes(product.id);
---

<div class="space-y-4 sm:space-y-5">
	<div
		transition:name={`product-brand-${product.id}`}
		class="inline-flex items-center rounded-full border border-border bg-card px-3 py-1 text-xs font-semibold text-muted-foreground shadow-soft-sm"
	>
		{product.brand.name}
	</div>

	<h1
		transition:name={`product-name-${product.id}`}
		class="font-display text-2xl leading-[1.2] sm:text-3xl lg:text-4xl"
	>
		{product.name}
	</h1>

	<div class="flex flex-wrap gap-2">
		<span class="inline-flex items-center rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
			{product.category.name}
		</span>
		{
			product.amount && (
				<span class="inline-flex items-center rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
					{product.amount}
				</span>
			)
		}
		{
			product.potency && (
				<span class="inline-flex items-center rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground">
					{product.potency}
				</span>
			)
		}
	</div>

	<div class="overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
		{inCampaign && (
			<div
				class="flex items-center justify-between gap-3 bg-secondary px-4 py-2 text-xs font-semibold text-secondary-foreground sm:px-6"
				data-campaign-live
			>
				<b class="font-display text-primary">{SALE_CAMPAIGN.name}</b>
				<span>Дуусахад <CampaignClock variant="inline" /></span>
			</div>
		)}
		<div class="space-y-4 p-4 sm:p-6">
			<div class="flex items-end justify-between gap-3">
				<div>
					<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
						Үнэ
					</div>
					<div class="flex flex-wrap items-baseline gap-x-3">
						<div
							class="font-display text-4xl text-foreground sm:text-5xl"
							data-inventory-price={product.id}
							transition:name={`product-price-${product.id}`}
						>
							{formatCurrency(product.price)}
						</div>
						{sale && (
							<span
								class="text-lg text-muted-foreground tabular-nums line-through"
								data-sale={product.id}
								data-compare-at={sale.compareAtPrice}
							>
								{formatCurrency(sale.compareAtPrice)}
							</span>
						)}
					</div>
					{sale && (
						<div class="mt-1.5 flex gap-1.5" data-sale={product.id} data-compare-at={sale.compareAtPrice}>
							<span class="rounded-full bg-sale px-2.5 py-0.5 text-xs font-bold text-sale-foreground">
								-{sale.percent}%
							</span>
							<span class="rounded-full bg-success px-2.5 py-0.5 text-xs font-bold text-success-foreground tabular-nums">
								{formatCurrency(sale.saved)} хэмнэнэ
							</span>
						</div>
					)}
				</div>
				<span
					data-inventory-stock-badge={product.id}
					class:list={[
						"rounded-full bg-muted px-3 py-1.5 text-xs font-semibold text-muted-foreground",
						{
							"low-stock-indicator":
								isInStock && product.stock <= LOW_STOCK_THRESHOLD,
						},
					]}
				>
					{isInStock
						? product.stock <= LOW_STOCK_THRESHOLD
							? "Цөөхөн үлдсэн"
							: "Бэлэн байна"
						: "Дууссан"}
				</span>
			</div>

			<div
				data-inventory-stock-meta={product.id}
				class:list={[
					"flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-muted-foreground sm:text-sm",
					{ hidden: !isInStock },
				]}
			>
				<span class="inline-flex items-center gap-1.5">
					<IconTruck class="h-4 w-4 text-cocoa/70" aria-hidden="true" />
					УБ-д өнөөдөр эсвэл маргааш хүргэнэ
				</span>
			</div>

			<div id="product-main-cta" transition:name={`product-add-to-cart-button-${product.id}`}>
				<ProductQuantitySelector
					client:only="solid-js"
					isInStock={isInStock}
					stock={product.stock}
					cartItem={{
						productId: product.id,
						quantity: 1,
						name: product.name,
						price: product.price,
						image: primaryImage,
						slug: product.slug,
					}}
				>
					<div slot="fallback" class="flex items-center gap-3">
						<div class="h-12 w-36 animate-pulse rounded-full border border-border bg-muted/30"></div>
						<div class="h-12 flex-1 animate-pulse rounded-full bg-muted/40"></div>
					</div>
				</ProductQuantitySelector>
			</div>
		</div>
	</div>

	<div class="flex flex-wrap items-center gap-x-5 gap-y-2 px-1 text-xs text-muted-foreground sm:text-sm">
		<span class="inline-flex items-center gap-1.5">
			<IconCheck class="h-4 w-4 text-cocoa/70" aria-hidden="true" />
			Баталгаатай
		</span>
		<span class="inline-flex items-center gap-1.5">
			<IconTruck class="h-4 w-4 text-cocoa/70" aria-hidden="true" />
			Хурдан хүргэлт
		</span>
		<span class="inline-flex items-center gap-1.5">
			<IconShield class="h-4 w-4 text-cocoa/70" aria-hidden="true" />
			Найдвартай
		</span>
		<span class="inline-flex items-center gap-1.5">
			<IconRefund class="h-4 w-4 text-cocoa/70" aria-hidden="true" />
			Буцаалт
		</span>
	</div>
</div>
