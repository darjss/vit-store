---
interface Props {
	baseUrl: string;
	dir: string | null;
	sort: string | null;
}

const { baseUrl, dir, sort } = Astro.props;

const options = [
	{ dir: null, label: "Онцлох", sort: null },
	{ dir: "desc", label: "Шинэ", sort: "createdAt" },
	{ dir: "asc", label: "Хямд", sort: "price" },
	{ dir: "desc", label: "Үнэтэй", sort: "price" },
] as const;

const hrefFor = (o: (typeof options)[number]) =>
	o.sort ? `${baseUrl}/1?sort=${o.sort}&dir=${o.dir}` : `${baseUrl}/1`;
const isActive = (o: (typeof options)[number]) =>
	o.sort ? sort === o.sort && dir === o.dir : !sort;
---

<div class="mb-3 flex items-center justify-end gap-2 sm:mb-4">
	<span class="font-bold text-[11px] text-muted-foreground uppercase tracking-wide">Эрэмбэ</span>
	<div class="flex overflow-hidden rounded-md border border-border shadow-soft-sm">
		{options.map((o, index) => (
			<a
				href={hrefFor(o)}
				aria-current={isActive(o) ? "true" : undefined}
				class={`flex h-11 min-w-11 items-center justify-center px-2.5 font-bold text-[11px] uppercase tracking-wide transition-colors duration-200 ease-out-quart focus-visible:z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset sm:px-3 ${isActive(o) ? "bg-secondary text-secondary-foreground" : "bg-card hover:bg-primary/20"} ${index > 0 ? "border-border border-l" : ""}`}
			>
				{o.label}
			</a>
		))}
	</div>
</div>
