---
interface Props {
	class?: string;
	variant?: "light" | "dark";
}

const { class: className, variant = "light" } = Astro.props;

const bodyPath =
	"M 94.99 73.62 C 95.51 79.88, 104.76 84.37, 94.56 94.56 C 84.37 104.76, 79.88 95.51, 73.62 94.99 C 69.56 99.79, 72.92 109.5, 58.5 109.5 C 44.08 109.5, 47.44 99.79, 43.38 94.99 C 37.12 95.51, 32.63 104.76, 22.44 94.56 C 12.24 84.37, 21.49 79.88, 22.01 73.62 C 17.21 69.56, 7.5 72.92, 7.5 58.5 C 7.5 44.08, 17.21 47.44, 22.01 43.38 C 21.49 37.12, 12.24 32.63, 22.44 22.44 C 32.63 12.24, 37.12 21.49, 43.38 22.01 C 47.44 17.21, 44.08 7.5, 58.5 7.5 C 72.92 7.5, 69.56 17.21, 73.62 22.01 C 79.88 21.49, 84.37 12.24, 94.56 22.44 C 104.76 32.63, 95.51 37.12, 94.99 43.38 C 99.79 47.44, 109.5 44.08, 109.5 58.5 C 109.5 72.92, 99.79 69.56, 94.99 73.62 Z";

const isDark = variant === "dark";
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 120 120"
	fill="none"
	aria-hidden="true"
	class={className}
>
	<g transform="rotate(-5 58.5 58.5)">
		<path
			d={bodyPath}
			transform="translate(3.5, 4)"
			fill={isDark ? "var(--color-primary-deep, #DCBB50)" : "var(--color-cocoa, #503322)"}
		/>
		<path
			d={bodyPath}
			fill="var(--color-primary, #FBDD67)"
			stroke={isDark ? undefined : "var(--color-foreground, #30271F)"}
			stroke-width={isDark ? undefined : "3.6"}
			stroke-linejoin={isDark ? undefined : "round"}
		/>
		<path
			d="M 27 45.5 Q 27 41 33 41 H 84 Q 90 41 90 45.5 L 87.5 56 Q 85.5 64 76 64 H 67 Q 62 64 60 58.5 L 58.5 55.5 L 57 58.5 Q 55 64 50 64 H 41 Q 31.5 64 29.5 56 Z"
			fill="var(--color-foreground, #30271F)"
		/>
		<path
			d="M 35 55 L 43 45.5"
			stroke="var(--color-background, #FBF8F0)"
			stroke-width="3.4"
			stroke-linecap="round"
		/>
		<path
			d="M 43 56.5 L 47.5 51"
			stroke="var(--color-background, #FBF8F0)"
			stroke-width="2.6"
			stroke-linecap="round"
			opacity="0.85"
		/>
		<path
			d="M 67.5 55 L 75.5 45.5"
			stroke="var(--color-background, #FBF8F0)"
			stroke-width="3.4"
			stroke-linecap="round"
		/>
		<path
			d="M 47 73 L 59 81 L 72.5 71.5"
			stroke="var(--color-foreground, #30271F)"
			stroke-width="5.2"
			stroke-linecap="round"
			stroke-linejoin="round"
		/>
	</g>
</svg>
