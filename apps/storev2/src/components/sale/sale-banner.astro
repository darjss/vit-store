---
import { SALE_CAMPAIGN } from "@vit/shared/domain/product";
import type { ProductForHome } from "@/lib/types";
import { campaignDates } from "@/lib/campaign";
import { toProductImageUrl } from "@/lib/image";
import CampaignClock from "./campaign-clock.astro";

interface Props {
	products: Array<ProductForHome>;
}

const { products } = Astro.props;
const thumbs = products.slice(0, 3);
---

{products.length > 0 && (
	<div class="mx-auto max-w-6xl px-4 pt-3 lg:px-8 lg:pt-6" data-campaign-live>
		<a
			href={SALE_CAMPAIGN.path}
			class="sale-banner relative block overflow-hidden rounded-3xl bg-secondary p-4 text-secondary-foreground shadow-soft transition-transform duration-150 ease-out active:scale-[0.99] lg:p-6"
		>
			<div class="absolute top-3 right-3 flex lg:top-5 lg:right-6" aria-hidden="true">
				{thumbs.map((product) => (
					<span class="sale-thumb -ml-2 block size-12 lg:size-20">
						<img
							src={toProductImageUrl(product.image, "cutout") || product.image}
							alt=""
							width="80"
							height="80"
							class="size-full object-contain drop-shadow-[0_4px_8px_rgb(0_0_0/0.35)]"
							loading="eager"
							decoding="async"
						/>
					</span>
				))}
			</div>
			<p class="text-[11px] font-bold tracking-wider text-secondary-foreground/65 tabular-nums">{campaignDates}</p>
			<p class="font-display text-2xl leading-none font-bold tracking-tight text-primary lg:text-4xl">{SALE_CAMPAIGN.name}</p>
			<p class="mt-1.5 text-[13px] text-secondary-foreground/80">{products.length} бараа {SALE_CAMPAIGN.percent}% хямдарлаа</p>
			<div class="mt-3 flex items-center justify-between gap-2">
				<CampaignClock />
				<span class="inline-flex h-10 shrink-0 items-center rounded-full bg-primary px-4 font-display text-[13px] font-bold text-primary-foreground shadow-lift">
					Үзэх →
				</span>
			</div>
		</a>
	</div>
)}

<style>
	/* The three product photos deal out like cards after the banner lands. */
	.sale-thumb:nth-child(1) {
		rotate: -6deg;
	}
	.sale-thumb:nth-child(3) {
		rotate: 6deg;
	}
	@media (prefers-reduced-motion: no-preference) {
		.sale-banner {
			animation: banner-rise 500ms var(--ease-out) backwards;
		}
		.sale-thumb {
			animation: thumb-deal 560ms var(--ease-playful-spring) backwards;
		}
		.sale-thumb:nth-child(1) {
			animation-delay: 180ms;
		}
		.sale-thumb:nth-child(2) {
			animation-delay: 240ms;
		}
		.sale-thumb:nth-child(3) {
			animation-delay: 300ms;
		}
	}
	@keyframes banner-rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
	@keyframes thumb-deal {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
	}
</style>
