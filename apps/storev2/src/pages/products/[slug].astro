---
import Breadcrumb from "@/components/product/breadcrumb.astro";
import ProductDetails from "@/components/product/product-details.astro";
import ProductImageCarousel from "@/components/product/product-image-carousel.tsx";
import ProductInfo from "@/components/product/product-info.astro";
import RecommendedProducts from "@/components/product/recommended-products.tsx";
import StickyMobileCta from "@/components/product/sticky-mobile-cta";
import Layout from "@/layouts/Layout.astro";
import { washBg } from "@/lib/wash";

export const prerender = true;

const SITE_URL = "https://amerikvitamin.mn";

import { api } from "@/lib/trpc";

export async function getStaticPaths() {
	const products = await api.product.getPrerenderCatalog.query();

	return products.flatMap((product) => {
		const canonicalSlug = `${product.slug}-${product.id}`;
		return [
			{
				params: { slug: canonicalSlug },
				props: { redirectTo: null },
			},
			...product.oldSlugs
				.filter((oldSlug) => oldSlug && oldSlug !== product.slug)
				.map((oldSlug) => ({
					params: { slug: `${oldSlug}-${product.id}` },
					props: { redirectTo: canonicalSlug },
				})),
		];
	});
}

interface Props {
	redirectTo: string | null;
}

const { slug } = Astro.params;
const { redirectTo } = Astro.props;

if (redirectTo) {
	return Astro.redirect(`/products/${redirectTo}/`, 301);
}

const slugParts = slug?.split("-") ?? [];
const productId = Number(slugParts.at(-1));

if (Number.isNaN(productId)) {
	return Astro.redirect("/404");
}

const productData = await api.product.getProductById.query({ id: productId });
if (!productData) {
	return Astro.redirect("/404");
}

const product = productData;

// Keep the generated canonical path honest if catalog data changes during a build.
const canonicalSlug = `${product.slug}-${product.id}`;
if (slug !== canonicalSlug) {
	return Astro.redirect(`/products/${canonicalSlug}/`, 301);
}

// This is build-time data for first paint. The client reconciler fetches the
// authoritative short-lived inventory snapshot before enabling purchase actions.
const isInStock = product.status === "active" && product.stock > 0;

const categoryHref = product.category?.slug
	? `/products/category/${product.category.slug}/1/`
	: `/products/?category=${product.categoryId}`;

const washKey = product.category?.slug ?? product.categoryId;
const productWashBg = washBg(washKey);

const breadcrumbItems = [
	{
		href: "/products/",
		label: "Бүтээгдэхүүн",
	},
	{
		href: categoryHref,
		label: product.category?.name || "Category",
	},
	{
		href: "",
		label: product.name,
	},
];

const primaryImage = product.images.find((img) => img.isPrimary)?.url || product.images[0]?.url || "";
const ogImage = `/og/products/${slug}.svg`;

function truncateAtWord(text: string, maxLength: number) {
	const normalized = text.replaceAll(/\s+/g, " ").trim();
	if (normalized.length <= maxLength) {return normalized;}
	const truncated = normalized.slice(0, maxLength + 1);
	const lastSpace = truncated.lastIndexOf(" ");
	return `${truncated.slice(0, lastSpace > 80 ? lastSpace : maxLength).trim()}…`;
}

// SEO metadata
const seoTitle = product.name;
const seoDescription = product.description 
	? truncateAtWord(product.description, 155)
	: `${product.name} - ${product.brand?.name || "АНУ"} брэндийн витамин, нэмэлт тэжээл. Америк Витамин дэлгүүрээс захиалаарай.`;

// Product JSON-LD Schema
const productSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	brand: {
		"@type": "Brand",
		name: product.brand?.name || "Америк Витамин"
	},
	description: product.description || seoDescription,
	image: product.images.map(img => img.url.startsWith("http") ? img.url : `${SITE_URL}${img.url}`),
	name: product.name,
	offers: {
		"@type": "Offer",
		availability: isInStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
		price: product.price,
		priceCurrency: "MNT",
		priceValidUntil: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
		seller: {
			"@type": "Organization",
			name: "Америк Витамин"
		},
		url: `${SITE_URL}/products/${slug}/`
	},
	sku: String(product.id),
	...(product.category && {
		category: product.category.name
	})
};

// BreadcrumbList JSON-LD Schema
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			item: SITE_URL,
			name: "Нүүр",
			position: 1
		},
		{
			"@type": "ListItem",
			item: `${SITE_URL}/products/`,
			name: "Бүтээгдэхүүн",
			position: 2
		},
		...(product.category ? [{
			"@type": "ListItem",
			item: product.category?.slug
			? `${SITE_URL}/products/category/${product.category.slug}/1/`
			: `${SITE_URL}/products/?category=${product.categoryId}`,
			name: product.category.name,
			position: 3
		}] : []),
		{
			"@type": "ListItem",
			item: `${SITE_URL}/products/${slug}/`,
			name: product.name,
			position: product.category ? 4 : 3
		}
	]
};
---

<Layout 
	title={seoTitle}
	description={seoDescription}
	image={ogImage}
	imageAlt={product.name}
>
	<script type="application/ld+json" data-product-jsonld set:html={JSON.stringify(productSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<div class="relative min-h-screen bg-hero-warm">
		<div
			class="relative z-10 mx-auto max-w-screen-2xl px-3 py-4 sm:px-6 sm:py-8 lg:px-8"
		>
			<Breadcrumb items={breadcrumbItems} />

			<div
				class="mb-12 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12"
			>
				<div class="w-full" transition:name={`product-image-${product.id}`} >
					<ProductImageCarousel
						client:visible
						images={product.images}
						productName={product.name}
						productId={product.id}
						washKey={washKey}
					>
						<div slot="fallback" class={`aspect-square min-h-[400px] rounded-2xl shadow-soft ${productWashBg}`}>
							<div class="h-full w-full animate-pulse rounded-2xl bg-dots-subtle"></div>
						</div>
					</ProductImageCarousel>
				</div>

			<div class="w-full">
				<ProductInfo
					product={product}
					primaryImage={primaryImage}
				/>
			</div>
			</div>

		<div class="mb-12">
			<ProductDetails
				product={{
					description: product.description,
					ingredients: product.ingredients,
					dailyIntake: product.dailyIntake,
					weightGrams: product.weightGrams,
					expirationDate: product.expirationDate,
					amount: product.amount,
					potency: product.potency,
				}}
			/>
		</div>

		<div class="border-t border-border/70 pb-8 pt-8">
			<RecommendedProducts
				client:visible
				currentProductId={product.id}
				categoryId={product.categoryId}
				brandId={product.brandId}
				washKey={washKey}
			>
				<div slot="fallback" class="min-h-[300px] py-6 sm:py-10">
					<h2 class="mb-5 font-display text-h3 sm:mb-6 sm:text-h2">Таньд таалагдаж магадгүй</h2>
					<div class="scrollbar-hide -mx-3 flex gap-3 overflow-x-auto px-3 pb-2 sm:mx-0 sm:gap-4 sm:px-0">
						{[1, 2, 3, 4].map(() => (
							<div class="w-[160px] shrink-0 sm:w-[200px] lg:w-[220px]">
								<div class="animate-pulse overflow-hidden rounded-2xl bg-card shadow-soft">
									<div class="aspect-square bg-muted/40"></div>
									<div class="space-y-2 p-3 sm:p-4">
										<div class="h-3 w-1/3 rounded bg-muted/60"></div>
										<div class="h-4 w-3/4 rounded bg-muted/60"></div>
										<div class="h-4 w-1/2 rounded bg-muted/60"></div>
									</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</RecommendedProducts>
		</div>
		</div>
	</div>

	<StickyMobileCta
			client:load
			isInStock={isInStock}
			cartItem={{
				productId: product.id,
				quantity: 1,
				name: product.name,
				price: product.price,
				image: primaryImage,
				slug: product.slug,
			}}
		/>
</Layout>

<script
	id="product-view-tracker"
	hidden
	data-product-id={product.id}
	data-product-name={product.name}
	data-product-price={product.price}
	data-product-slug={slug}
></script>
<script>
	// Track product view on page load (supports view transitions)
	let _productViewTracked = false;
	function trackProductView() {
		if (_productViewTracked) {return;}
		const el = document.getElementById("product-view-tracker");
		if (!el || !window.posthog) {return;}
		window.posthog.capture("product_viewed", {
			product_id: Number(el.dataset.productId),
			product_name: el.dataset.productName ?? "",
			product_price: Number(el.dataset.productPrice),
			product_slug: el.dataset.productSlug ?? "",
		});
		_productViewTracked = true;
	}
	
	// Track on initial load and view transitions
	document.addEventListener("astro:page-load", trackProductView);
</script>
