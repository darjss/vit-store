---
// Server-rendered: full HTML generated at request time for maximum reliability

import Layout from "@/layouts/Layout.astro";
import ServerProductCard from "@/components/product/server-product-card.astro";
import Pagination from "@/components/product/pagination.astro";
import SortBar from "@/components/product/sort-bar.astro";
import { resolveCategorySeo } from "@/lib/category-seo";
import { api } from "@/lib/trpc";
import { WASH_BG, washFor } from "@/lib/wash";

const PAGE_SIZE = 24;
const SITE_URL = "https://amerikvitamin.mn";


const { page: pageParam, slug } = Astro.params;
if (!slug || !pageParam || !/^\d+$/.test(pageParam)) {
	return Astro.redirect("/404");
}

const page = Number(pageParam);
if (!Number.isSafeInteger(page) || page < 1) {
	return Astro.redirect("/404");
}
if (pageParam !== String(page)) {
	return Astro.redirect(`/products/category/${slug}/${page}/${Astro.url.search}`, 301);
}

const sortParam = Astro.url.searchParams.get("sort");
const dirParam = Astro.url.searchParams.get("dir");
const sortField =
	sortParam === "price" || sortParam === "createdAt" || sortParam === "stock"
		? sortParam
		: undefined;
const sortDirection =
	dirParam === "asc" || dirParam === "desc" ? dirParam : undefined;
const sortQuery = sortField
	? `?sort=${sortField}&dir=${sortDirection ?? "desc"}`
	: "";

const category = await api.category.getCategoryBySlug.query({ slug });
if (!category) {
	return Astro.redirect("/404");
}

const { items: products, pagination } = await api.product.getPaginatedProducts.query({
	categoryId: category.id,
	page,
	pageSize: PAGE_SIZE,
	sortDirection,
	sortField,
});
if (page > pagination.totalPages) {
	return Astro.redirect("/404");
}

const baseUrl = `/products/category/${slug}`;
const washClass = WASH_BG[washFor(category.id)];
const pageUrl = `${SITE_URL}${baseUrl}/${page}/`;

const { faqs, intro, seoDescription, seoTitle } = resolveCategorySeo({
	description: category.description,
	name: category.name,
	page,
	seoDescription: category.seoDescription,
	seoTitle: category.seoTitle,
	slug,
	totalCount: pagination.totalCount,
	totalPages: pagination.totalPages,
});

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", item: SITE_URL, name: "Нүүр", position: 1 },
		{ "@type": "ListItem", item: `${SITE_URL}/products`, name: "Бүтээгдэхүүн", position: 2 },
		{ "@type": "ListItem", item: `${SITE_URL}${baseUrl}/1/`, name: category.name, position: 3 },
		...(page > 1 ? [{ "@type": "ListItem", item: pageUrl, name: `Хуудас ${page}`, position: 4 }] : []),
	],
};

const collectionSchema = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	about: category.name,
	description: seoDescription,
	inLanguage: "mn-MN",
	isPartOf: { "@type": "WebSite", name: "Америк Витамин", url: SITE_URL },
	name: seoTitle,
	url: pageUrl,
};

const itemListSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	itemListElement: products.map((p, i) => ({
		"@type": "ListItem",
		name: p.name,
		position: (page - 1) * PAGE_SIZE + i + 1,
		url: `${SITE_URL}/products/${p.slug}-${p.id}`,
	})),
	name: category.name,
	numberOfItems: pagination.totalCount,
};

const faqSchema =
	faqs.length > 0
		? {
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: faqs.map((faq) => ({
					"@type": "Question",
					acceptedAnswer: {
						"@type": "Answer",
						text: faq.answer,
					},
					name: faq.question,
				})),
			}
		: null;
Astro.cache.set({
	maxAge: 86_400,
	swr: 604_800,
	tags: ["site-shell", "catalog", `category-${category.id}`],
});
---

<Layout title={seoTitle} description={seoDescription} canonical={pageUrl}>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
	{faqSchema && (
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	)}

	<div class="mx-auto max-w-screen-2xl px-3 py-4 sm:px-6 sm:py-6 lg:px-8">
		<!-- Breadcrumb -->
		<nav aria-label="Breadcrumb" class="mb-3 flex flex-wrap items-center gap-1.5 font-medium text-muted-foreground text-xs sm:mb-4 sm:text-sm">
			<a href="/" class="hover:text-foreground hover:underline">Нүүр</a>
			<span>/</span>
			<a href="/products" class="hover:text-foreground hover:underline">Бүтээгдэхүүн</a>
			<span>/</span>
			<a href={`${baseUrl}/1/`} class="hover:text-foreground hover:underline">{category.name}</a>
			{page > 1 && (
				<>
					<span>/</span>
					<span class="text-foreground">Хуудас {page}</span>
				</>
			)}
		</nav>

		<!-- Header on category-keyed wash tint -->
		<header class={`enter-rise mb-3 rounded-2xl border border-border ${washClass} px-4 py-4 sm:mb-4 sm:px-6 sm:py-5`}>
			<h1 class="font-bold font-display text-xl tracking-tight sm:text-2xl lg:text-3xl">
				{category.name}
			</h1>
			<p class="mt-1 font-medium text-foreground/70 text-xs sm:text-sm">
				Нийт {pagination.totalCount} бүтээгдэхүүн{page > 1 ? ` — Хуудас ${page}/${pagination.totalPages}` : ""}
			</p>
		</header>

		<!-- Banner -->
		{category.bannerImage && (
			<div class="mb-3 overflow-hidden rounded-2xl border border-border shadow-soft sm:mb-4">
				<img
					src={category.bannerImage}
					alt={category.name}
					class="h-32 w-full object-cover sm:h-48"
					width="1200"
					height="300"
				/>
			</div>
		)}

		{page === 1 && (
			<div class="mb-4 space-y-3 rounded-2xl border border-border bg-card p-3 shadow-soft-sm sm:mb-5 sm:p-4">
				{intro.map((paragraph) => (
					<p class="text-sm leading-relaxed text-foreground/90 sm:text-base">{paragraph}</p>
				))}
			</div>
		)}

		<SortBar baseUrl={baseUrl} sort={sortField ?? null} dir={sortDirection ?? null} />

		<!-- Products Grid -->
		<div class="grid grid-cols-2 gap-2.5 sm:gap-4 lg:grid-cols-3 xl:grid-cols-4">
			{products.map((product, index) => (
				<div
					class="enter-rise"
					style={`--enter-delay:${Math.min(index, 8) * 40}ms`}
				>
					<ServerProductCard product={product} />
				</div>
			))}
		</div>

		<!-- Pagination -->
		{pagination.totalPages > 1 && (
			<Pagination page={page} totalPages={pagination.totalPages} baseUrl={baseUrl} search={sortQuery} />
		)}

		{faqs.length > 0 && (
			<section class="mt-8 border-border border-t pt-6 sm:mt-10 sm:pt-8" aria-labelledby="category-faq-heading">
				<h2 id="category-faq-heading" class="font-bold font-display text-lg tracking-tight sm:text-xl">
					Түгээмэл асуулт
				</h2>
				<div class="mt-4 space-y-3">
					{faqs.map((faq) => (
						<details class="group rounded-2xl border border-border bg-card px-4 py-3 shadow-soft-sm open:pb-4">
							<summary class="cursor-pointer list-none font-medium text-sm sm:text-base [&::-webkit-details-marker]:hidden">
								{faq.question}
							</summary>
							<p class="mt-2 text-foreground/80 text-sm leading-relaxed sm:text-base">
								{faq.answer}
							</p>
						</details>
					))}
				</div>
			</section>
		)}
	</div>
</Layout>
