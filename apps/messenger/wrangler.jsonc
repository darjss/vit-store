{
	"name": "vit-store-messenger",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	// Zernio's message.received webhook points here after cutover (plan 029).
	"routes": [{ "pattern": "messenger.amerikvitamin.mn", "custom_domain": true }],
	// Same Axiom destination as the store API, so one wide event per turn lands
	// next to the server logs. Workers Logs keeps a queryable copy too.
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "persist": true, "destinations": ["axiom-logs"] },
	},
	// Non-secret settings. Local wrangler dev overrides all of them from .dev.vars.
	// Secrets (wrangler secret put): ZERNIO_API_KEY, ZERNIO_WEBHOOK_SECRET,
	// OPENAI_API_KEY, ADMIN_TOKEN, ADMIN_BOT_TOKEN, TELEGRAM_ADMIN_BOT_TOKEN,
	// TELEGRAM_ADMIN_CHAT_ID, TELEGRAM_WEBHOOK_SECRET.
	"vars": {
		"MODEL": "gpt-6-luna",
		"STORE_API_URL": "https://api.amerikvitamin.mn",
		"STORE_PUBLIC_URL": "https://amerikvitamin.mn",
		"ZERNIO_ACCOUNT_IDS": "6abd496a8fa7e621847d9954",
		"ZERNIO_BASE_URL": "https://zernio.com/api",
	},
	// Skill SKILL.md files import as text for the admin system prompt.
	"rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
	// The admin query tool runs model-written TypeScript in isolated Workers.
	"worker_loaders": [{ "binding": "LOADER" }],
	// The extract tools run Workers AI vision on staged invoice/chat images.
	"ai": { "binding": "AI" },
	// Admin Telegram photos stage under messenger-inbound/ here.
	"r2_buckets": [
		{
			"binding": "MESSENGER_INBOUND_BUCKET",
			"bucket_name": "vit-store-bucket-prod",
			"preview_bucket_name": "vit-store-bucket-prod",
		},
	],
	"durable_objects": {
		"bindings": [
			{ "name": "Ingress", "class_name": "Ingress" },
			{ "name": "Conversation", "class_name": "Conversation" },
			{ "name": "Admin", "class_name": "Admin" },
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Ingress", "Conversation"],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["Admin"],
		},
	],
}
